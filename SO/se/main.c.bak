#include <stdint.h>
#include <unistd.h>
#include <stdio.h>
#include <stdlib.h>
#include <getopt.h>
#include <fcntl.h>
#include <sys/ioctl.h>
#include <linux/types.h>
#include <linux/spi/spidev.h>

#include <string.h>
#include "spi.h"



int main(int argc, char *argv[])
{
int ret = 0;
int spinum = 0;
int speed = 200*1000; 
char* dev   = NULL;
char* baudrate   = NULL;

    ret = SPI_Open();
    
    baudrate   = argv[1];
    if (baudrate!=NULL)
    {
    	speed = atoi(baudrate);
    }
    spi_set_speed(speed);
	printf("set_speed\n");
	
	spi_set_mode(ret);
	printf("set mode\n");
	fm_se_get_version();
	
	SPI_Close();
	
}