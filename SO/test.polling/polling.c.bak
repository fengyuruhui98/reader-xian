void func_polling()
{
int 	i;
int 	ret, intElapseTime;
unsigned char 	cpubuf[100], atslen;
struct timeval tv1,tv2;
struct timezone tz1,tz2;

	//polling
	rf_select(0);
	for(i = 0; i < 3; i++)
	{
		mcml_pwr_on();
		set_timeout(4000);
		if((ret = mcml_request2(PICC_REQALL, cpubuf)) == 0)
		{
			gettimeofday(&tv1,&tz1);
			break;
		}
		mcml_pwr_off();
	}
	if(i >= 3)
		return ;
	if( (cpubuf[0] & 0xC0 ) == 0x40)
	{
		ret = UL_Anticoll_Select(cpubuf);
		if( ret == 0)
		{
			gettimeofday(&tv2, &tz2);
			intElapseTime = (((tv2.tv_sec - tv1.tv_sec) * 1000000) + tv2.tv_usec - tv1.tv_usec)/1000;
			printf("func_polling UL time %d(ms)\n", intElapseTime);
			return ;
		}
		return ;
	}
	//anticoll
	ret = mcml_anticoll(cpubuf);
	if(ret != 0)
		return ;
	//select
	ret = mcml_select(cpubuf, &atslen);
	if(ret != 0)
		return ;
	if( (atslen & 0x24) == 0x20)
	{
		//ats
		ret = mifpro_ats(1, cpubuf, &atslen);
		if (ret == 0)
		{
			gettimeofday(&tv2, &tz2);
			intElapseTime = (((tv2.tv_sec - tv1.tv_sec) * 1000000) + tv2.tv_usec - tv1.tv_usec)/1000;
			printf("func_polling CPU time %d(ms)\n", intElapseTime);
			return ;
		}
	}else
	{
		//
		memcpy(m1_keyA[0], "\xfc\x61\xcb\xb5\x37\x51", 6);
		if(0 == sector_read(m1_keyA[0], 0, 0, 0, 0x11, cpubuf))
		{
			gettimeofday(&tv2, &tz2);
			intElapseTime = (((tv2.tv_sec - tv1.tv_sec) * 1000000) + tv2.tv_usec - tv1.tv_usec)/1000;
			printf("func_polling M1 time %d(ms)\n", intElapseTime);
			return ;
		}
	}
	return ;
}