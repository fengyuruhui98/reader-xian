			PRINTK("YKT passenger %02x METRO passenger %02x\n", 
				tpCard1912.YKTPassengeMap_val[i].YKTpassenage, tpCard1912.YKTPassengeMap_val[i].passenage);
#endif		
	}	
	fclose(intFile);
	return 0;
}

