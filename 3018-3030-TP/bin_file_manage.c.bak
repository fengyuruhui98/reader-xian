				tpBlacklist1104.SectionCardBlack_val.SectionCardBlacklist_val[i].cardActionCode, tpBlacklist1104.SectionCardBlack_val.SectionCardBlacklist_val[i].cardStatusCode);
#endif
	}
	//clear 分段3：产品黑名单参数
