			tpCalendar1107.DateTimes_val.DateTime_val[i].datetypeId, tpCalendar1107.DateTimes_val.DateTime_val[i].timecodenumber);
#endif
		tpCalendar1107.DateTimes_val.DateTime_val[i].Time_val = NULL;
